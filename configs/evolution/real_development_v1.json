{
  "schema_version": "scheme-evolution-experiment-config-v0.2",
  "purpose": "One bounded, proposal-only real-artifact development round with binary class support on both sides of the walk-forward split.",
  "limitations": [
    "The admission window was selected after auditing this consumed development archive and is not independent effectiveness evidence.",
    "The adjusted-price artifact is a local ignored input and must pass dataset_preflight_label_aware.json before any blind provider call.",
    "A fresh untouched-company final test remains required after proposal changes stop."
  ],
  "cli": {
    "initial_genome": "configs/evolution/initial_genome.json",
    "candidate_json": "configs/evolution/codex_candidates_v1.json",
    "cases_path": "runs/cold_start/formal/cold-start-formal-openrouter-2026-05-13-clean-universe/05_packets/historical_cases.json",
    "documents_path": "runs/cold_start/formal/cold-start-formal-openrouter-2026-05-13-clean-universe/04_documents/documents_and_catalysts.json",
    "price_histories_path": "runs/cold_start/evolution/input/abc_adjusted_price_histories_2026-08-02.json",
    "admission_starts": "2025-08-05",
    "admission_window_days": 15,
    "purge_days": 15,
    "embargo_days": 15,
    "generations": 1,
    "children_per_generation": 2,
    "max_candidates": 2,
    "top_k": 3,
    "prediction_similarity_threshold": 0.95,
    "max_api_cost": 20.0,
    "max_concurrency": 1,
    "random_seed": 42
  },
  "evaluation_contract": {
    "version": "six-month-max-multiple-v1",
    "horizon_months": 6,
    "price_field": "adjusted_close",
    "multiple_calculation_type": "max_future_price_ratio",
    "smoothing_window_days": 5,
    "class_boundaries": {
      "A": {
        "min_inclusive": 0.0,
        "max_exclusive": 2.0
      },
      "B": {
        "min_inclusive": 2.0,
        "max_exclusive": 3.0
      },
      "C": {
        "min_inclusive": 3.0,
        "max_exclusive": null
      }
    },
    "positive_classes": [
      "B",
      "C"
    ],
    "primary_metric": "binary_f1",
    "diagnostic_metrics": [
      "binary_precision",
      "binary_recall",
      "multiclass_macro_f1",
      "class_c_recall",
      "ordinal_distance"
    ]
  }
}
