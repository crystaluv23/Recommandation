{
  "cli": {
    "run_id": "mock-abc-two-rounds",
    "output_dir": "runs/cold_start/evolution/mock-abc-two-rounds",
    "initial_genome": "configs/evolution/initial_genome.json",
    "candidate_json": "configs/evolution/codex_candidates_v1.json",
    "mock_llm": true,
    "generations": 2,
    "children_per_generation": 2,
    "max_candidates": 4,
    "top_k": 3,
    "prediction_similarity_threshold": 0.95,
    "random_seed": 42,
    "max_api_cost": 20.0
  },
  "evaluation_contract": {
    "version": "six-month-max-multiple-v1",
    "horizon_months": 6,
    "price_field": "adjusted_close",
    "multiple_calculation_type": "max_future_price_ratio",
    "smoothing_window_days": 5,
    "class_boundaries": {
      "A": {
        "min_inclusive": 0.0,
        "max_exclusive": 2.0
      },
      "B": {
        "min_inclusive": 2.0,
        "max_exclusive": 3.0
      },
      "C": {
        "min_inclusive": 3.0,
        "max_exclusive": null
      }
    },
    "positive_classes": [
      "B",
      "C"
    ],
    "primary_metric": "binary_f1",
    "diagnostic_metrics": [
      "binary_precision",
      "binary_recall",
      "multiclass_macro_f1",
      "class_c_recall",
      "ordinal_distance"
    ]
  }
}
