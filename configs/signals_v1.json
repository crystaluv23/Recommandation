        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true},
        "parameters": {"positive_min": 100000000, "negative_max": 10000000}
      },
      "tests": [{"name": "cash buffer", "metadata_key": "cash_reserves", "value": 150000000, "expected": "positive"}]
    },
    {
      "spec": {
        "signal_id": "pilot_to_volume",
        "version": 1,
        "category": "customers",
        "definition": {"description": "Judge whether customers moved from pilot or validation into volume purchase or scaled deployment."},
        "execution": {"type": "llm", "skill_file": "skill.md"},
        "raw_retrieval": {"source_types": ["earnings_call", "company_announcement", "customer_announcement"]},
        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true}
      },
      "skill": "Extract only explicit customer-stage evidence. Positive requires a stated move from trial, qualification, or pilot into repeat volume purchase or scaled deployment. Treat partnership language without deployment evidence as neutral. Return literal supporting and counter spans.",
      "tests": [{"name": "partnership alone is not volume", "expected": "neutral"}]
    },
    {
      "spec": {
        "signal_id": "guidance_acceleration",
        "version": 1,
        "category": "management",
        "definition": {"description": "Judge whether fresh management guidance materially strengthens the growth path versus prior guidance."},
        "execution": {"type": "llm", "skill_file": "skill.md"},
        "raw_retrieval": {"source_types": ["earnings_call", "filing", "company_announcement"]},
        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true}
      },
      "skill": "Compare current guidance with explicit prior guidance available in the input. Positive requires a material upward change in level, timing, or conviction; generic optimism is neutral. Preserve contrary qualifiers and literal spans.",
      "tests": [{"name": "generic optimism", "expected": "neutral"}]
    },
    {
      "spec": {
        "signal_id": "order_quality",
        "version": 1,
        "category": "orders",
        "definition": {"description": "Judge whether disclosed orders are binding, economically material, timed, and likely to convert to revenue."},
        "execution": {"type": "llm", "skill_file": "skill.md"},
        "raw_retrieval": {"source_types": ["filing", "company_announcement", "customer_announcement", "earnings_call"]},
        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true}
      },
      "skill": "Separate binding purchase orders and funded backlog from MOUs, framework agreements, maximum-ceiling awards, and non-binding pipeline. Evaluate amount, customer commitment, delivery timing, cancellation rights, and revenue conversion. Cite literal spans.",
      "tests": [{"name": "non-binding MOU", "expected": "neutral"}]
    },
    {
      "spec": {
        "signal_id": "commercialization_status",
        "version": 1,
        "category": "product",
        "definition": {"description": "Judge whether a technical milestone has become a sellable and repeatable commercial product."},
        "execution": {"type": "llm", "skill_file": "skill.md"},
        "raw_retrieval": {"source_types": ["filing", "company_announcement", "customer_announcement", "earnings_call"]},
        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true}
      },
      "skill": "Distinguish laboratory demonstration, certification, pilot production, first commercial shipment, and repeatable scaled sales. Positive requires evidence of real commercial delivery or repeat revenue, not a roadmap claim. Cite literal spans.",
      "tests": [{"name": "technical demo only", "expected": "neutral"}]
    },
    {
      "spec": {
        "signal_id": "customer_concentration",
        "version": 1,
        "category": "risks",
        "definition": {"description": "Judge whether the growth thesis depends excessively on one customer or one customer program."},
        "execution": {"type": "llm", "skill_file": "skill.md"},
        "raw_retrieval": {"source_types": ["filing", "earnings_call", "customer_announcement"]},
        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true}
      },
      "skill": "Extract disclosed revenue, backlog, order, or deployment concentration. Negative means the growth thesis is materially dependent on one customer with limited replication evidence. Positive means adoption is demonstrably diversified. Unknown identity alone is unavailable, not neutral.",
      "tests": [{"name": "single customer majority", "expected": "negative"}]
    },
    {
      "spec": {
        "signal_id": "negative_word_count",
        "version": 1,
        "category": "news",
        "definition": {"description": "Count configured negative terms in complete point-in-time company news source documents."},
        "execution": {"type": "deterministic", "function": "news.negative_word_count"},
        "raw_retrieval": {"source_types": ["news"]},
        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true},
        "parameters": {"terms": ["decline", "loss", "risk", "delay", "investigation", "default"], "negative_count_min": 1}
      },
      "tests": [{"name": "negative news terms", "expected": "negative"}]
    },
    {
      "spec": {
        "signal_id": "financing_listing_action",
        "version": 1,
        "category": "catalysts",
        "definition": {"description": "Judge whether financing, restructuring, or listing actions materially change runway, dilution, or tradability."},
        "execution": {"type": "llm", "skill_file": "skill.md"},
        "raw_retrieval": {"source_types": ["filing", "company_announcement", "news"]},
        "evidence_policy": {"require_source": true, "require_timestamp": true, "require_exact_span": true}
      },
      "skill": "Identify completed or binding financing, debt restructuring, exchange-compliance, redemption, reverse-split, or listing actions. Separate completed actions from proposals. Explain whether the point-in-time effect supports runway/tradability or increases dilution/distress, with literal spans.",
      "tests": [{"name": "proposed financing is not completed", "expected": "neutral"}]
    }
