    "gross_margin_change:v4": {
      "spec": {
        "category": "financial",
        "definition": {
          "description": "Measure latest reported gross margin (GrossProfit/revenue) minus the same fiscal window one year earlier. Anchor to latest canonical revenue end and shortest explicitly reported duration on a tied end, before requiring current profit or comparators. Require exact month-aligned 3/6/9/12-month windows and same currency; YTD compares identical YTD windows. Missing current/prior gross profit or revenue, zero revenue, unresolved required-window conflicts, stale current periods, unsupported stubs or 52/53-week calendars are unavailable; never replace the latest anchor with an older complete pair. Numeric change >=0.08 is positive, <=-0.02 negative, otherwise neutral; categories describe this measurement, not future returns. Preserve full literal operands and evidence. Default current freshness is 550 days; absolute change above 2 has partial coverage and confidence 0.5 without changing the measurement."
        },
        "evidence_policy": {
          "require_exact_span": true,
          "require_source": true,
          "require_timestamp": true
        },
