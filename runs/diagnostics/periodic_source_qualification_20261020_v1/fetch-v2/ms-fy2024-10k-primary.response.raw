000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1225" decimals="-6" name="us-gaap:Assets" scale="6" id="f-4365">378</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1225" decimals="-6" name="us-gaap:Liabilities" scale="6" id="f-4366">189</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1226" decimals="-6" name="us-gaap:Assets" scale="6" id="f-4367">753</ix:nonFraction>&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1226" decimals="-6" name="us-gaap:Liabilities" scale="6" id="f-4368">502</ix:nonFraction>&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/></tr><tr