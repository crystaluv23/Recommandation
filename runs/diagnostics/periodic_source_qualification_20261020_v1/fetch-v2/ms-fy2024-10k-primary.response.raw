0000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-609" decimals="-6" name="ms:NonredeemableFundsMaturityWithinNextFiveYearsAtCarryingValue" format="ixt:num-dot-decimal" scale="6" id="f-1627">2,016</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span></td><td style="border-top:0.5pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/></tr><tr><td colspan="3" style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt;text-align:left;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">5-10 years</span></td><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-607" decimals="-6" name="ms:NonredeemableFundsMaturityAfterFiveThroughTenYearsAtCarryingValue" format="ixt:num-dot-decimal" scale="6" id="f-1628">1,432</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-609" decimals="-6" name="ms:NonredeemableFundsMaturityAfterFiveThroughTenYearsAtCarryingValue" format="ixt:num-dot-decimal" scale="6" id="f-1629">1,334</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span>