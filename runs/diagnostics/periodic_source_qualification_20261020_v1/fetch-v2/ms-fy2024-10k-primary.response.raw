;font-weight:400;line-height:100%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/></tr><tr><td colspan="3" style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 5.5pt;text-align:left;text-indent:-4.5pt;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:100%">Letters of credit and other financial guarantees</span></td><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1180" decimals="-6" name="us-gaap:OtherCommitmentDueInNextTwelveMonths" scale="6" id="f-4296">39</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1180" decimals="-6" name="us-gaap:OtherCommitmentDueInSecondAndThirdYear" scale="6" id="f-4297">2</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1180" decimals="-6" name="us-gaap:O