d #000000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:100%">Debt&#160;and<br/>Equity<br/>Interests</span></td></tr><tr><td colspan="3" style="border-top:0.5pt solid #000000;padding:2px 1pt;text-align:left;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">Residential mortgages</span></td><td style="border-top:0.5pt solid #000000;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%">$</span></td><td style="border-top:0.5pt solid #000000;padding:2px 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1308" decimals="-6" name="ms:VariableInterestEntityReportingEntityInvolvementUnpaidPrincipalBalanceAmount" format="ixt:num-dot-decimal" scale="6" id="f-4499">17,316</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:400;line-height:120%">&#160;</span></td><td style="border-top:0.5pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td style="border-top:0.5pt solid #000000;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%">$</span></td><td style="border-top:0.5pt solid #000000;padding:2px 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:7pt;font-weight:700;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1309" decimals="-6" name="us-gaap:Assets" format="ixt:num-dot-decimal" scale="6" id="f-4500">2,497</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',s