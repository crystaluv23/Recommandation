nt-family:'Arial',sans-serif;font-size:6.5pt;font-weight:400;line-height:100%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:6.5pt;font-weight:700;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-1203" decimals="-6" name="us-gaap:GuaranteeObligationsMaximumExposure" format="ixt:fixed-zero" scale="6" id="f-4330">&#8212;</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:6.5pt;font-weight:400;line-height:100%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="2" style="border-top:0.5pt solid #d3d3d3;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:6.5pt;font-weight:700;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-1204" decimals="-6" name="us-gaap:GuaranteeObligationsMaximumExposure" format="ixt:num-dot-decimal" scale="6" id="f-4331">87,305</ix:nonFraction></span><span style="color:#000000;font-family:'Arial',sans-serif;font-size:6.5pt;font-weight:400;line-height:100%">&#160;</span></td><td style="border-top:0.5pt solid #d3d3d3;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="padding:0 1pt"/><td colspan="2" style="border-top:0.5pt solid #dbdbdb;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:6.5pt;font-weight:700;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-1205" decimals="-6" name="ms:GuarantorObligationsAssetsCurrentCarryingValue" format="ixt:fixed-zero" scale="6" id="f-4332">&#8212;</ix:nonFraction></span><span style="color:#000000;font-family: