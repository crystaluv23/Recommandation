{"request_id":"0710f8ab1e81b07dc4a48e539a4af326","results":{"ticker":"LW","name":"Lamb Weston Holdings, Inc.","market":"stocks","locale":"us","primary_exchange":"XNYS","type":"CS","active":true,"currency_name":"usd","cik":"0001679273","composite_figi":"BBG003CVMLQ2","share_class_figi":"BBG003CVMLR1","market_cap":7.704024044969999e+09,"phone_number":"208.938.1047","address":{"address1":"599 S. RIVERSHORE LANE","city":"EAGLE","state":"ID","postal_code":"83616"},"description":"Lamb Weston is North America's largest and the world's second-largest producer of branded and private-label frozen potato products, both by volume and value. The company's portfolio is anchored by french fries, but it also sells sweet potato fries, tater tots, diced potatoes, mashed potatoes, hash browns, and chips. Roughly two thirds of revenue comes from its home market of North America, with none of the other 100 countries the company sells into representing a significant share. McDonald's is Lamb Weston's single-largest customer at 14% of fiscal 2024 sales, with no other company representing more than 10%. Lamb Weston became an independent company in 2016 when it was spun off from Conagra.","sic_code":"2030","sic_description":"CANNED, FROZEN & PRESERVD FRUIT, VEG & FOOD SPECIALTIES","ticker_root":"LW","homepage_url":"https://www.lambweston.com","total_employees":10700,"list_date":"2016-11-01","branding":{"logo_url":"https://api.massive.com/v1/reference/company-branding/bGFtYndlc3Rvbi5jb20/images/2024-10-01_logo.svg","icon_url":"https://api.massive.com/v1/reference/company-branding/bGFtYndlc3Rvbi5jb20/images/2024-10-01_icon.jpeg"},"share_class_shares_outstanding":142640000,"weighted_shares_outstanding":142640697,"round_lot":100},"status":"OK"}