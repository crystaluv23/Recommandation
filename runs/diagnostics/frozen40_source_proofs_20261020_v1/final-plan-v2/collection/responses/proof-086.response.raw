{"request_id":"5f41a2c7eea3295a25080f7a5412d4c6","results":{"ticker":"OMER","name":"Omeros Corporation","market":"stocks","locale":"us","primary_exchange":"XNAS","type":"CS","active":true,"currency_name":"usd","cik":"0001285819","composite_figi":"BBG000JLP4B4","share_class_figi":"BBG001SPJH21","market_cap":2.8447335268e+08,"phone_number":"206-676-5000","address":{"address1":"201 ELLIOTT AVENUE WEST","city":"SEATTLE","state":"WA","postal_code":"98119"},"description":"Omeros Corp is a United States-based clinical-stage biopharmaceutical company engaged in discovering, developing, and commercializing small-molecule and protein therapeutics for large-market as well as orphan indications targeting immunologic disorders including complement-mediated diseases, cancers, and addictive and compulsive disorders. The drug candidate in the pipeline of complement-targeted therapeutics is narsoplimab (OMS721), a proprietary, patented human monoclonal antibody targeting mannan-binding lectin-associated serine protease 2, the key activator of the lectin pathway of complement. Clinical development of narsoplimab is currently focused on hematopoietic stem cell transplant-associated thrombotic microangiopathy and immunoglobulin nephropathy.","sic_code":"2834","sic_description":"PHARMACEUTICAL PREPARATIONS","ticker_root":"OMER","homepage_url":"https://www.omeros.com","total_employees":202,"list_date":"2009-10-08","branding":{"logo_url":"https://api.massive.com/v1/reference/company-branding/b21lcm9zLmNvbQ/images/2025-04-04_logo.png"},"share_class_shares_outstanding":68055826,"weighted_shares_outstanding":68055826,"round_lot":100},"status":"OK"}