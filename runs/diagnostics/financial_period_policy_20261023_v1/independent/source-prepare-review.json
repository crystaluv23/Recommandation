        "execution": {
          "type": "deterministic",
          "function": "financial.revenue_acceleration_adjacent",
          "callable_status": "registered",
          "contract": "Measure current standalone quarter YoY revenue growth minus immediately previous\n    standalone quarter YoY growth (four reported windows); annual uses adjacent annual\n    YoY growth (three windows). Anchor to latest canonical revenue end, shortest reported\n    duration on ties. Require exact month-aligned calendar/fiscal boundaries and currency;\n    no skipped quarter, YTD subtraction, annual/quarter mixing, older-pair fallback or\n    unresolved conflicting values. Missing/stale/zero-denominator/unsupported-calendar\n    inputs are unavailable. Thresholds preserve positive_min/negative_max: >= positive_min\n    is positive, else <= negative_max negative, else neutral (defaults 0/positive_min).\n    max_period_age_days defaults to 550; plausible_abs_max defaults to 5 and downgrades\n    extreme observations to partial/0.5 without changing their measurement or state.\n    ",
          "parameter_names": [
            "positive_min",
            "negative_max",
            "plausible_abs_max",
            "max_period_age_days"
          ],
          "configured_parameters": {
            "positive_min": 0.05,
            "negative_max": -0.05
          }
        }
      },
