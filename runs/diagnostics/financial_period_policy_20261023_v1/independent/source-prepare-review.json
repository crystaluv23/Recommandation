        "execution": {
          "type": "deterministic",
          "function": "financial.gross_margin_change_yoy",
          "callable_status": "registered",
          "contract": "Measure latest GrossProfit/revenue minus the same reported fiscal window's margin\n    one year earlier. Anchor to latest canonical revenue end, shortest reported duration\n    on ties, before matching profit. Require exact 3/6/9/12-month aligned reported windows,\n    matching currencies and exact calendar-year shifts of both boundaries; YTD compares\n    identical YTD windows. Missing/stale/zero-revenue/unsupported-calendar or unresolved\n    conflicting facts are unavailable, never replaced by an older complete pair.\n    Thresholds preserve positive_min/negative_max: >= positive_min positive, else\n    <= negative_max negative, else neutral (defaults 0/positive_min).\n    max_period_age_days defaults to 550; plausible_abs_max defaults to 2 and downgrades\n    extremes to partial/0.5 without changing their measurement or state.\n    ",
          "parameter_names": [
            "positive_min",
            "negative_max",
            "plausible_abs_max",
            "max_period_age_days"
          ],
          "configured_parameters": {
            "positive_min": 0.08,
            "negative_max": -0.02
          }
        }
      },
