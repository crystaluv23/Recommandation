{
  "controls": [
    {
      "id": "original-sealed",
      "obligation": "All ten saved views and eight answered requests omit request_budget; two fifth requests prepared but not consumed; original failures persist."
    },
    {
      "id": "exact-current",
      "obligation": "Current reservation equals exact serialized transformed messages plus effective output; metadata self-cost solved to conservative fixed point, digit transitions near 9/10,99/100,999/1000."
    },
    {
      "id": "equal-cap",
      "obligation": "At cap admits; cap minus one rejects before dispatch; each single/aggregate/call independently enforced."
    },
    {
      "id": "next-lower-bound",
      "obligation": "Unknown next grammar: shared global prompt plus minimum normal/typed grammar + empty payload is lower bound; never current repair prompt cost presented as universal next bound; metadata wording discloses lower bound only."
    },
    {
      "id": "identity",
      "obligation": "Aliases including explicit SEC accession/projected source handles and unicode change bytes; estimate equals complete after reversible projection."
    },
    {
      "id": "transport-envelope",
      "obligation": "Native local-role estimator uses exact local message bytes; provider estimate wire bytes only for nonlocal provider path. Wrapper-added envelope is included exactly once in estimate and complete."
    },
    {
      "id": "usage-malformed",
      "obligation": "Malformed JSON/nonobject response or identity-rejected consumed answer charges reservation/call; neither exception may silently refund consumed call."
    },
    {
      "id": "usage-pending",
      "obligation": "InputCaptured, LocalRoleResponsePending, ExternalRequestPending/pre-dispatch exception and budget rejection charge zero; same model remains able to reconstruct attempt without false debt."
    },
    {
      "id": "typed-repair",
      "obligation": "Invalid action with output_patch_contract preserves patch instructions/base/allowed paths and normal invalid feedback; budget hard stop remains EvolutionControlFlow and never creates semantic no_pattern or repair."
    },
    {
      "id": "shared-model-seeds",
      "obligation": "One shared model across hypothesis/discovery retains one aggregate lifetime; production wires existing per-request cap only."
    },
    {
      "id": "replay-sequential",
      "obligation": "Earlier replay view sees only earlier consumed calls; no sum of future prepared files; duplicated exact-response replay causes no duplicate physical receipts, while logical replay reservation is reconstructed consistently."
    },
    {
      "id": "bounded-original-controls",
      "obligation": "Only explicit diagnostic opt-in single32768/aggregate98304/calls6; old sealed stages never advanced or rewritten; local pass grants no fresh control permission."
    }
  ],
